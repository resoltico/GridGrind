+    private void validateDates(Document doc, XPath xpath, List<XSSFSingleXmlCell> singleCells, List<XSSFTable> tables) throws XPathExpressionException {
+        for (XSSFSingleXmlCell linked : singleCells) {
+            if (!"date".equals(linked.getXmlDataType())) continue;
+            Node node = (Node) xpath.evaluate(linked.getXpath(), doc, XPathConstants.NODE);
+            if (node != null && !node.getTextContent().isEmpty()) dateSerial.applyAsDouble(new DateInput(node.getTextContent(), linked.getXpath(), 0));
+        }
+        for (XSSFTable table : tables) {
+            NodeList nodes = (NodeList) xpath.evaluate(table.getCommonXpath(), doc, XPathConstants.NODESET);
+            for (int row = 0; row < nodes.getLength(); row++) {
+                Node node = nodes.item(row).cloneNode(true);
+                for (XSSFTableColumn column : table.getColumns()) {
+                    XSSFXmlColumnPr linked = column.getXmlColumnPr();
+                    if (linked == null || !"date".equals(linked.getXmlDataType())) continue;
+                    String local = linked.getLocalXPath();
+                    local = local.substring(local.indexOf('/', 1) + 1);
+                    String value = (String) xpath.evaluate(local, node, XPathConstants.STRING);
+                    if (!value.isEmpty()) dateSerial.applyAsDouble(new DateInput(value, linked.getXPath(), row));
+                }
+            }
+        }
+    }
 
