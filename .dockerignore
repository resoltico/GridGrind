# Exclude everything by default. The Docker build assembles GridGrind from source in a multi-stage
# build, so only the Gradle entrypoint, production modules, and legal files belong in context.
**

# Root Gradle entrypoint and shared build logic.
!build.gradle.kts
!gradle.properties
!gradlew
!settings.gradle.kts
!gradle/

# Production modules needed for :cli:shadowJar.
!authoring-java/
!cli/
!contract/
!engine/
!excel-foundation/
!executor/

# Legal files published into the runtime image.
!LICENSE
!NOTICE
!PATENTS.md
!LICENSE-APACHE-2.0
!LICENSE-BSD-2-CLAUSE
!LICENSE-BSD-3-CLAUSE
!LICENSE-EDL-1.0

# Drop generated and local-only state from otherwise included trees.
.gradle/
tmp/
**/.local/
**/build/
