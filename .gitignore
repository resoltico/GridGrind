# Gradle caches and build outputs
.gradle/
build/
**/build/
out/
target/

# IDE compiler output (VSCode Java extension, Eclipse)
bin/
**/bin/

# Kotlin daemon sessions
.kotlin/

# JVM and compiler artifacts
*.class
hs_err_pid*
replay_pid*

# Editor and IDE metadata
.idea/
.vscode/
.classpath
.project
.settings/
*.iml
*.ipr
*.iws

# Temporary and scratch directories
.tmp-*/
/tmp/

# Gradle-created project-discovery root that contains no tracked source in this repo.
/buildSrc/

# Project-local Gradle user home when GRADLE_USER_HOME is pointed at the project root.
/.gradle-home/

# Generated local workbook outputs.
/generated-workbooks/

# OS and local scratch files
.claude/
.gemini/

# Repository-owned agent instructions are source files, not local assistant scratch.
!/AGENTS.md

.DS_Store
*.swp
*.swo
*~
Thumbs.db
ehthumbs.db
Desktop.ini
