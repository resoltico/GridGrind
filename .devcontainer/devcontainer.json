{
  "name": "GridGrind Contributor",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "target": "contributor"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1.10.2@sha256:661b0fd4c57a7e0bd14d99701ab9bc824719678a9319118728f8d9c59441b7e4": {
      "version": "29.9.3",
      "dockerDashComposeVersion": "none",
      "installDockerBuildx": false,
      "moby": false,
      "installDockerComposeSwitch": false
    }
  },
  "workspaceFolder": "/workspaces/gridgrind",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/gridgrind,type=bind,consistency=cached",
  "mounts": [
    "source=gridgrind-gradle-home,target=/home/vscode/.gradle,type=volume",
    "source=gridgrind-java-cache,target=/home/vscode/.cache,type=volume"
  ],
  "containerEnv": {
    "GRIDGRIND_DEVCONTAINER": "1"
  },
  "postStartCommand": "./scripts/devcontainer-prepare-user-home.sh",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "customizations": {
    "vscode": {
      "settings": {
        "java.configuration.runtimes": [
          {
            "name": "JavaSE-27",
            "path": "/opt/java/openjdk",
            "default": true
          }
        ],
        "java.import.gradle.enabled": true,
        "java.gradle.buildServer.enabled": "on",
        "remote.extensionKind": {
          "redhat.java": [
            "workspace"
          ],
          "vscjava.vscode-gradle": [
            "workspace"
          ],
          "vscjava.vscode-java-test": [
            "workspace"
          ]
        },
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "EditorConfig.EditorConfig",
        "redhat.java",
        "vscjava.vscode-gradle",
        "vscjava.vscode-java-test"
      ]
    }
  }
}
